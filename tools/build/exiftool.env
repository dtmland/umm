# Direct-download fallback pin for `umm setup exiftool`.
# Unix source archive matches libumm v0.1.1's tested ExifTool (advisory in
# `umm doctor`). Package-manager installs are unpinned (concept §4.2).
#
# ExifTool source: https://github.com/exiftool/exiftool/archive/refs/tags/13.59.tar.gz
UMM_EXIFTOOL_VERSION=13.59
UMM_EXIFTOOL_URL=https://github.com/exiftool/exiftool/archive/refs/tags/13.59.tar.gz
UMM_EXIFTOOL_SHA256=87d3317882fdae9cb4dcfe57a96a378d0132ffc02c731315bf128b19ddcf7aac
#
# Windows upstream zip (Phil Harvey 64-bit / Oliver Betz packaging). SHA-256
# is of that zip; leave empty to skip the zip fallback (winget still used).
UMM_EXIFTOOL_WINDOWS_URL=https://exiftool.org/exiftool-13.59_64.zip
UMM_EXIFTOOL_WINDOWS_SHA256=
